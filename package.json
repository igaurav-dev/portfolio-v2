{
  "name": "portfolio-v2",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start --port 8008 --hostname 127.0.0.1",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "deploy": "./deploy/deploy.sh",
    "deploy:pull": "./deploy/deploy.sh --pull",
    "rollback": "./deploy/rollback.sh",
