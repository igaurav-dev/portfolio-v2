    "pm2:logs": "pm2 logs portfolio",
    "pm2:status": "pm2 describe portfolio"
  },
  "dependencies": {
    "mongodb": "^7.5.0",
    "next": "15.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18.18"
  }
}
