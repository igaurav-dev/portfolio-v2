# ---------------------------------------------------------------
# All optional. The site runs with none of these set.
# ---------------------------------------------------------------

# Public URL — used for canonical tags, sitemap, OG images.
NEXT_PUBLIC_SITE_URL=https://igaurav.dev

# Enables synthesised answers on /ask and résumé extraction in /admin.
# Without it, /ask still works: it returns verbatim passages instead.
ANTHROPIC_API_KEY=

# Admin. On first start against an empty store, these create the first
# account. After that the credentials live in the database and you change
# them from the Account page — these values stop being the way in.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Signs session tokens for both the web cookie and the mobile bearer token.
# Changing it logs everyone out. Make it long and random.
ADMIN_SECRET=change-me-to-a-long-random-string
ADMIN_SESSION_TTL_MS=43200000      # browser session — 12h
ADMIN_MOBILE_TTL_MS=2592000000     # mobile token — 30d

# GitHub — powers /proof (receipts). Works without a token at 60 req/hr;
# a token with ZERO scopes raises that to 5,000. No scopes are required
# for public data, so do not grant any.
GITHUB_USERNAME=
GITHUB_TOKEN=
GITHUB_CACHE_TTL_MS=900000
# The repo shown in the footer card.
PORTFOLIO_REPO=igaurav-dev/portfolio-v2
GITHUB_TZ=Asia/Kolkata

# Storage for ALL content — profile, projects, decisions, experience, skills,
# routine, résumé history — plus check-ins and the persistent answer cache.
# Leave unset and everything falls back to content/*.json and data/.
# On first read against an empty database, collections seed themselves from
# the JSON files, so a fresh Mongo comes up already populated.
MONGODB_URI=
MONGODB_DB=portfolio

# /ask spend controls
ASK_RATE_LIMIT=8              # synthesised answers per hour per visitor
ASK_RATE_WINDOW_MS=3600000
ASK_DAILY_BUDGET_USD=1        # hard daily ceiling across all visitors
ASK_CACHE_THRESHOLD=0.84      # cosine similarity for a cache hit
ASK_CACHE_TTL_MS=604800000
ASK_CONTEXT_CHARS=3600        # prompt context budget
ASK_RATE_IN_PER_MTOK=3        # $/M input tokens, for the cost readout
ASK_RATE_OUT_PER_MTOK=15
